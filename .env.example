# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Job Platforms ────────────────────────────────────────────────────────────
LINKEDIN_EMAIL=you@email.com
LINKEDIN_PASSWORD=

NAUKRI_EMAIL=you@email.com
NAUKRI_PASSWORD=

# ─── Notifications ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via CallMeBot (free, personal use — https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# 1. Save +34 644 44 88 98 in WhatsApp contacts
# 2. Send "I allow callmebot to send me messages" to that number
# 3. You'll receive your API key by WhatsApp
WHATSAPP_PHONE=91XXXXXXXXXX   # your number with country code, no +
WHATSAPP_API_KEY=

GMAIL_SENDER=you@gmail.com
GMAIL_RECIPIENT=you@gmail.com
# Path to Gmail OAuth2 credentials JSON from Google Cloud Console
GMAIL_CREDENTIALS_PATH=resources/credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=resources/credentials/gmail_token.json

# ─── Candidate Details (used for Greenhouse / Lever form auto-fill) ───────────
CANDIDATE_NAME=Your Full Name
CANDIDATE_EMAIL=you@email.com
CANDIDATE_PHONE=+91XXXXXXXXXX

# ─── Application Settings ─────────────────────────────────────────────────────
# Hard deadline IST — applications must be submitted before this time
APPLY_DEADLINE_IST=09:15

# Timezone for all scheduling
TIMEZONE=Asia/Kolkata

# Max auto-apply per day (Path B)
MAX_APPLY_PATH_B=15

# Max human-queue per day (Path A)
MAX_QUEUE_PATH_A=3

# Minimum score threshold for Path B auto-apply (0-100)
SCORE_THRESHOLD_PATH_B=72

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db/jireh.db

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/jireh.log