# ─── Nexus Environment Variables ──────────────────────────────────────────────
# Copy to .env and fill in your values.
# Or run: python orchestrator.py init   to generate .env interactively.

# ─── Job Platforms ────────────────────────────────────────────────────────────
NAUKRI_EMAIL=you@email.com
NAUKRI_PASSWORD=

# ─── Notifications ────────────────────────────────────────────────────────────
# Telegram: create a bot via @BotFather, get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail OAuth2 — get credentials from Google Cloud Console
GMAIL_SENDER=you@gmail.com
GMAIL_RECIPIENT=you@gmail.com
GMAIL_CREDENTIALS_PATH=resources/credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=resources/credentials/gmail_token.json

# ─── Candidate Details (used for Greenhouse / Lever form auto-fill) ───────────
CANDIDATE_NAME=Your Full Name
CANDIDATE_EMAIL=you@email.com
CANDIDATE_PHONE=+1XXXXXXXXXX

# ─── Scheduling ───────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
APPLY_DEADLINE_IST=09:15

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///db/nexus.db

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/nexus.log
